{
  "watch": ["."],
  "ext": "js,json",
  "ignore": ["node_modules", "*.test.js", "*.spec.js"],
  "exec": "node server.js",
  "env": {
    "NODE_ENV": "development",
    "PORT": 3001
  },
  "delay": 500,
  "quiet": false,
  "verbose": false,
  "events": {
    "start": "echo '🚀 後台服務器啟動中...'",
    "crash": "echo '❌ 服務器崩潰，等待重啟...'",
    "restart": "echo '🔄 服務器重啟中...'"
  }
}